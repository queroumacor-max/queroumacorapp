<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false (auditoria de segurança mobile, 2026-09-13): a
         sessão do Supabase mora em localStorage/cookies DENTRO da WebView
         (lib/sessionStorageHybrid.ts, hybridAuthStorage) — dados que o
         Android guarda em `app_webview/` no diretório do app. Com
         allowBackup=true (o default) esses dados entram no Auto Backup pra
         nuvem (Google Drive, atrelado à conta Google) e no backup local via
         `adb backup`; sem chave de app pra criptografar o conteúdo, o token
         de sessão ficaria recuperável por quem tiver acesso à conta Google
         do usuário ou (com depuração USB ligada) ao aparelho. Sem
         allowBackup, nada disso é copiado — só custo: reinstalar o app não
         restaura sessão/preferências sozinho, a pessoa loga de novo (mesmo
         custo que web/PWA já têm hoje). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Telas grandes (recomendação do Play contra o build 10100/WebIntoApp,
             que travava orientação): o app roda em qualquer orientação e é
             redimensionável. `resizeableActivity=true` é explícito (já é o
             default em targetSdk 24+, mas o Play quer sem ambiguidade). NÃO há
             `screenOrientation` nem `maxAspectRatio` — nada trava tablet/
             foldable/ChromeOS. O `configChanges` abaixo já declara
             orientation|screenSize|smallestScreenSize|screenLayout, então a
             Activity se redimensiona sem recriar (sem tela branca ao girar). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link do OAuth (fluxo A). O esquema é br.com.queroumacor.app
                 (o que lib/native/auth.ts usa em NATIVE_OAUTH_REDIRECT), declarado
                 EXPLICITAMENTE — NÃO derivado do applicationId (br.com.queroumacor),
                 senão o callback não bateria. Já está nas Redirect URLs do Supabase. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="br.com.queroumacor.app" android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push nativo (Android 13+): sem esta permissão o plugin FirebaseMessaging
         nunca consegue mostrar notificação; a concessão em runtime é pedida por
         registerNativePush → requestPermissions em lib/native/push.ts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Câmera. O @capacitor/camera NÃO injeta esta permissão sozinho (a doc dele
         manda declarar aqui), e sem ela dois caminhos morrem de uma vez: o
         Camera.getPhoto() nativo E o getUserMedia do components/CameraCapture.tsx,
         porque a WebView só concede VIDEO_CAPTURE se o app tiver a permissão. O
         CameraCapture é justamente a saída de emergência de quando a galeria não
         abre — sem isso o pintor fica sem nenhum caminho pra foto.
         O AAB do WebIntoApp declarava CAMERA; o primeiro AAB Capacitor (10200)
         não, e foi por isso que ele não foi testado em campo. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false" é obrigatório aqui: declarar a permissão CAMERA faz o
         Play EXIGIR implicitamente o hardware de câmera e sumir com o app dos
         aparelhos que não têm uma. O app funciona sem câmera (a foto vira
         galeria/navegador), então a exigência não pode existir. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Microfone. Mesma regra da câmera: o chat de voz do Seu Zé (e Alice/Fê/
         Senna) grava por getUserMedia({audio}) na WebView
         (lib/hooks/useVoiceRecorder), e a WebView só concede AUDIO_CAPTURE se o
         app declarar RECORD_AUDIO. Sem isto o microfone é negado sozinho — a
         permissão nem chega a ser pedida — e a voz morre no app. iOS já tem o
         NSMicrophoneUsageDescription no Info.plist. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MODIFY_AUDIO_SETTINGS: NÃO é opcional, é o que fazia o microfone
         falhar mesmo com a permissão concedida nos ajustes do app.
         O BridgeWebChromeClient do Capacitor 6, ao receber o
         `onPermissionRequest` de AUDIO_CAPTURE, pede DUAS permissões de uma
         vez — MODIFY_AUDIO_SETTINGS **e** RECORD_AUDIO — e só chama
         `request.grant()` se TODAS voltarem concedidas (o callback faz um AND
         sobre o Map de resultados). Permissão não declarada no Manifest é
         negada pelo sistema na hora, sem diálogo: a AND dava false, a WebView
         recusava, e o getUserMedia rejeitava com NotAllowedError — enquanto a
         tela de permissões do Android mostrava o microfone ativo.
         É permissão NORMAL: não abre diálogo nenhum, só precisa existir. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- required="false" pelo mesmo motivo da câmera: declarar RECORD_AUDIO faz
         o Play exigir hardware de microfone implicitamente e sumir com o app de
         aparelhos sem um. Gravar voz é opcional (dá pra digitar), então não
         pode virar exigência. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Vibração. O @capacitor/haptics usa o Vibrator do Android, que exige
         VIBRATE. Sem ela TODO o háptico da Onda A falha em silêncio: trocar aba
         (BottomNav), curtir e salvar (usePostInteractions) e publicar
         (usePublishPost). É permissão NORMAL — não abre diálogo, o usuário nem
         vê; só precisa estar declarada. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Estado da rede. O @capacitor/network exige ACCESS_NETWORK_STATE pra ler
         a conectividade. Sem ela o <OfflineBanner> (faixa "sem conexão") e o
         isOnlineNow() de lib/native/network.ts não enxergam nada, e a Onda C
         fica pela metade. Também NORMAL — sem diálogo. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Localização (runtime). O filtro "📍 Perto de você" do feed chama
         navigator.geolocation.getCurrentPosition (lib/services/nearbyFeed.ts,
         usado em app/feed/FeedView.tsx). Mesma regra da câmera/microfone: a
         WebView só concede a localização se o app declarar a permissão — senão
         nega sozinha, sem perguntar. COARSE basta: o feed filtra por cidade,
         não precisa de precisão de GPS fino. iOS já tem o
         NSLocationWhenInUseUsageDescription no Info.plist. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- required="false" pelo mesmo motivo da câmera: declarar localização faz o
         Play exigir o hardware implicitamente e sumir com o app de aparelhos sem
         GPS. "Perto de você" é UM filtro entre vários — o app funciona sem. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
</manifest>

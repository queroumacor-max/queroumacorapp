# iOS / Capacitor wrapper. O projeto Xcode gerado por `npx cap add ios` AGORA
# E VERSIONADO (App.xcodeproj, App.xcworkspace, Podfile, storyboards, assets),
# com Info.plist / PrivacyInfo.xcprivacy / AppDelegate.swift curados por cima
# do boilerplate. O que fica de fora e so o que o `cap sync` regenera ou o que
# e local da maquina.
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/App/Podfile.lock
ios/capacitor-cordova-ios-plugins/
ios/App/public/

# Android — keystore e segredos NUNCA entram no repo
android.keystore
android.keystore.passwords
keystore.properties
app/build/
.gradle/
local.properties
# Capacitor Android: keystore de assinatura e senhas — NUNCA commitar (usar
# secure file / secret no CI: Codemagic ou GitHub Actions)
*.jks
*.keystore
key.properties
android/key.properties
# iOS: chave de assinatura APNs
*.p8
# Firebase: config do app. NÃO é segredo forte (vai no APK), mas não deve ser
# commitada — o CI a materializa de uma variável e apaga na hora (codemagic.yaml).
google-services.json
GoogleService-Info.plist
# Keystore materializado pelo CI dentro da build
android/app/release.keystore

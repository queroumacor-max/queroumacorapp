{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Avaliação de migração @cloudflare/next-on-pages → @opennextjs/cloudflare
  // (branch isolada claude/next16-opennext-eval). NÃO É config de deploy —
  // o projeto real ainda publica via Cloudflare Pages + wrangler.toml.
  // Preenchido só o suficiente pra `opennextjs-cloudflare build` rodar
  // localmente; nomes/buckets/IDs são placeholders.
  "main": ".open-next/worker.js",
  "name": "queroumacor-next",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}

# WhatsApp Cloud API (via Dualhook, numero em Coexistence) — a Evolution
# API (Baileys/Render) foi aposentada em 2026-09-05 e removida do codigo.
# DUALHOOK_API_KEY autentica envio (lib/api/_services/whatsapp.ts) e a
# consulta de templates (app/api/whatsapp/templates).
DUALHOOK_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Verify Token gerado pelo Dualhook, conferido no GET de verificacao do
# webhook (app/api/whatsapp/webhook).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Segredo NOSSO (openssl rand -hex 24) no ?token= da URL cadastrada no
# Dualhook — o modo `payload` (padrao) exige isso pra autenticar o POST,
# ja que o X-Hub-Signature-256 e assinado pelo app do Dualhook, nao pelo
# nosso META_APP_SECRET.
WHATSAPP_WEBHOOK_URL_SECRET=
# Segredo PROPRIO da varredura de follow-up horaria (pg_cron), dedicado
# desde 2026-09-18 pra nao compartilhar raio de vazamento com o webhook —
# ver app/api/whatsapp/followup e migrations/2026-09-18-whatsapp-followup
# -dedicated-secret.sql.
WHATSAPP_FOLLOWUP_URL_SECRET=
# NOTA (auditoria externa de identidade, 2026-09-17,
# docs/EXTERNAL_SECURITY_BASELINE.md secao 14/15): a Evolution API
# (Baileys/Render, EVOLUTION_API_URL/EVOLUTION_API_KEY/EVOLUTION_INSTANCE/
# EVOLUTION_WEBHOOK_TOKEN) foi removida DESTE arquivo de exemplo porque o
# codigo nao usa mais nenhuma dessas envs pra ENVIO (so a rota
# /api/whatsapp-evo/ping segue no ar pra diagnostico manual, e nao
# depende delas pra funcionar sem token). NAO CONFIRMADO se a instancia
# no Render ainda esta rodando com a API key ativa — verificar no painel
# do Render e, se realmente morta, desligar a instancia e revogar
# EVOLUTION_API_KEY/EVOLUTION_WEBHOOK_TOKEN no Cloudflare Pages (se ainda
# estiverem la).

# Push nativo (FCM HTTP v1) — canal do app empacotado, separado do web push
# (VAPID). Do JSON da service account do Firebase. Secret no CF Pages.
# Ausentes = canal nativo inerte; web push segue funcionando.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

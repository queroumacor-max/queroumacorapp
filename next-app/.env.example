# .env.example — SÓ NOMES, NUNCA VALORES. Copie pra `.env.local` (gitignored)
# e preencha. Em produção tudo vive no painel do Cloudflare Pages: as
# `NEXT_PUBLIC_*` como "Plain text" (são inlinadas no bundle do navegador no
# BUILD), todo o resto como "Secret" (só existe em runtime, no request
# context — ler por `getRuntimeEnv()`, nunca `process.env` direto).
#
# REGRA: variável que começa com NEXT_PUBLIC_ é PÚBLICA por definição (vai pro
# bundle, pro APK e pro IPA). Nunca prefixar um segredo assim.

# ─── Supabase (público: URL + anon key; a segurança é a RLS) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Par sem prefixo (fallback do servidor). URL e chave SEMPRE do mesmo projeto.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SEGREDO. Só servidor (rotas admin, webhooks, cotas). Ignora a RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sentry ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SEGREDO. Só no build (upload de source maps).
SENTRY_AUTH_TOKEN=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Lista de e-mails separados por vírgula (porta de emergência das rotas admin).
ADMIN_EMAILS=

# ─── IA ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_IMG_MODEL=
WHATSAPP_AI_MODEL=

# ─── Mercado Pago ────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_ENFORCE=

# ─── Compras in-app (stubs; NÃO ligar sem verificação real) ──────────────────
IAP_PRODUCTION_VERIFICATION_ENABLED=

# ─── WhatsApp Cloud API via Dualhook ─────────────────────────────────────────
DUALHOOK_API_KEY=
DUALHOOK_API_BASE=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_AUTH_MODE=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Segredo que vai no `?token=` da URL cadastrada no Dualhook (par: painel CF
# Pages + URL do Dualhook têm que ser idênticos).
WHATSAPP_WEBHOOK_URL_SECRET=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_TEMPLATE_ABORDAGEM=
WHATSAPP_TEMPLATE_ABORDAGEM_CIDADE=

# ─── Evolution API (canal APOSENTADO; envs ficam só como ponte) ──────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_TOKEN=

# ─── Push ────────────────────────────────────────────────────────────────────
# Web push (VAPID). A pública vai pro bundle; a privada é SEGREDO.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Segredo compartilhado entre o trigger do banco (app_settings) e /api/push-notify.
PUSH_INTERNAL_SECRET=
# Push nativo (FCM HTTP v1) — do JSON da service account do Firebase.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── Build / diagnóstico (públicos) ──────────────────────────────────────────
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_BUILD=
